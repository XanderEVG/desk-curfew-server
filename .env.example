# PostgreSQL
POSTGRES_DB=curfew_db
POSTGRES_USER=curfew
POSTGRES_PASSWORD=change_me

DATABASE_URL=postgresql+asyncpg://curfew:change_me@db:5432/curfew_db
DATABASE_URL_SYNC=postgresql+psycopg2://curfew:change_me@db:5432/curfew_db

# MQTT
MQTT_HOST=srv2.clusterfly.ru
MQTT_PORT=9992
MQTT_USE_SSL=true
MQTT_USERNAME=your_user
MQTT_PASSWORD=your_password
MQTT_TOPIC_PREFIX=your_user/curfew/kids

# Сервер
SERVER_TIMEZONE=Asia/Yekaterinburg
LOG_LEVEL=INFO

SECRET_KEY=change_me_to_random_string
SESSION_COOKIE_NAME=curfew_session
SESSION_MAX_AGE=604800